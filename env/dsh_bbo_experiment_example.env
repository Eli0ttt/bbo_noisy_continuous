# Scheme-B / no-Cordis environment template.
# Copy to env/dsh_bbo_experiment.env, fill in credentials/endpoints, then:
#   chmod 600 env/dsh_bbo_experiment.env
# Never commit or send the filled file.

# ---------- Primary A ----------
DEEPSEEK_BASE_URL='https://REPLACE_WITH_PRIMARY_API_BASE/v1'
DEEPSEEK_MODEL='deepseek-v4-flash-s1'
DEEPSEEK_API_KEY='REPLACE_WITH_YOUR_OWN_KEY'
DEEPSEEK_ALLOW_AGENT_HOST='REPLACE_WITH_PRIMARY_API_HOST'
MODEL="$DEEPSEEK_MODEL"

# ---------- Reviewer B ----------
COLLAB_REVIEWERS='B'
AGENT_B_BASE_URL='https://REPLACE_WITH_REVIEWER_API_BASE/v1'
AGENT_B_MODEL='GLM-5.2-W4A8'
AGENT_B_API_KEY='REPLACE_WITH_YOUR_OWN_KEY'
# AGENT_B_FOCUS='causal attribution, family lock-in, and next-experiment quality'

# ---------- Local paths ----------
EXP_ROOT="$HOME/experiments"
BBO_ROOT="$EXP_ROOT/bbo_noisy_continuous"
DSH_ROOT="$EXP_ROOT/deepseek-harness"
TASK_ROOT="$BBO_ROOT/dsh_rsi_runs/bbo_noisy_continuous_prebuilt"
JOBS_DIR="$BBO_ROOT/dsh_rsi_jobs"
NODE_ROOT="$HOME/.nvm/versions/node/v22.23.2"
HARBOR_BIN="$HOME/.local/share/uv/tools/harbor/bin/harbor"
HARBOR_PY="$HOME/.local/share/uv/tools/harbor/bin/python"

# ---------- Research duration ----------
COLLAB_TOTAL_SEC=3600

